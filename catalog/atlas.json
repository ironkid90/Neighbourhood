      "mcp.json edits",
      "live config.yaml edits",
      "gt install ~/gt",
      "Mayor / polecats",
      "beads-mcp",
      "mega-plugin that owns Telegram",
      "stacking extra memory providers on mem0",
      "TradingAgents / swarm factory"
